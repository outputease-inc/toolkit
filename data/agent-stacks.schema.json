{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "tool": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "purpose": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "role": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "route": {
        "type": "string",
        "enum": [
          "base",
          "backend:supabase",
          "has_frontend",
          "has_analytics",
          "has_e2e_tests"
        ],
        "description": "Routing context that determines when this agent tool is included"
      },
      "section": {
        "type": "string",
        "enum": [
          "Core Workflow",
          "Quality & Review",
          "Development Tools",
          "Infrastructure",
          "Design",
          "Observability",
          "Setup"
        ],
        "description": "Section grouping matching PLUGINS-INDEX tier structure"
      },
      "category": {
        "type": "string",
        "enum": [
          "plugin",
          "mcp-server"
        ],
        "description": "Entry classification: Claude Code plugin or MCP server"
      },
      "layer": {
        "type": "string",
        "enum": [
          "agent"
        ],
        "description": "Architectural layer: all agent-stack entries operate at the agent layer"
      },
      "maturity": {
        "type": "string",
        "enum": [
          "beta",
          "stable"
        ],
        "description": "beta=experimental (requires agentNotes), stable=production-ready"
      },
      "condition": {
        "type": "string",
        "enum": [
          "always",
          "optional",
          "has_frontend",
          "has_database",
          "has_ci",
          "has_analytics",
          "has_e2e_tests",
          "backend:supabase"
        ],
        "description": "Inclusion condition for agent plugin provisioning"
      },
      "platforms": {
        "type": "object",
        "properties": {
          "contentSite": {
            "type": "boolean"
          },
          "desktopApp": {
            "type": "boolean"
          },
          "mobileApp": {
            "type": "boolean"
          },
          "tooling": {
            "type": "boolean"
          },
          "webApp": {
            "type": "boolean"
          }
        },
        "required": [
          "contentSite",
          "desktopApp",
          "mobileApp",
          "tooling",
          "webApp"
        ],
        "additionalProperties": false
      },
      "url": {
        "anyOf": [
          {
            "type": "string",
            "format": "uri"
          },
          {
            "type": "null"
          }
        ]
      },
      "hasMcp": {
        "type": "boolean"
      },
      "relatedTo": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "dependsOn": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "selectionMode": {
        "type": "string",
        "enum": [
          "always-included",
          "auto-included",
          "selectable"
        ],
        "description": "always-included=mandatory, auto-included=default-on, selectable=user-chosen"
      },
      "exclusionGroup": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "code-review"
            ],
            "description": "Mutually exclusive agent tool group — only one member selected per project context"
          },
          {
            "type": "null"
          }
        ]
      },
      "bundle": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "core-workflow",
              "quality-review"
            ],
            "description": "Named bundle grouping agent tools installed together"
          },
          {
            "type": "null"
          }
        ]
      },
      "priority": {
        "type": "string",
        "enum": [
          "optional",
          "recommended",
          "required"
        ],
        "description": "optional=nice-to-have, recommended=best-practice, required=mandatory"
      },
      "agentNotes": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 500
          },
          {
            "type": "null"
          }
        ]
      },
      "tier": {
        "type": "string",
        "enum": [
          "1",
          "2",
          "3",
          "4",
          "5",
          "6",
          "7"
        ],
        "description": "Installation priority tier (1=core, 7=optional setup)"
      },
      "installCommand": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "marketplace": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
          },
          {
            "type": "null"
          }
        ],
        "description": "GitHub owner/repo of a third-party plugin marketplace; null for claude-plugins-official"
      },
      "componentCounts": {
        "type": "object",
        "properties": {
          "commands": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "skills": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "agents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "hooks": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "commands",
          "skills",
          "agents",
          "hooks"
        ],
        "additionalProperties": false
      },
      "mcpConfig": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "stdio",
                  "sse"
                ]
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "type",
              "command",
              "args"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "requiresAuth": {
        "type": "boolean"
      }
    },
    "required": [
      "tool",
      "purpose",
      "role",
      "route",
      "section",
      "category",
      "layer",
      "maturity",
      "condition",
      "platforms",
      "url",
      "hasMcp",
      "relatedTo",
      "dependsOn",
      "selectionMode",
      "exclusionGroup",
      "bundle",
      "priority",
      "agentNotes",
      "tier",
      "installCommand",
      "marketplace",
      "componentCounts",
      "mcpConfig",
      "requiresAuth"
    ],
    "additionalProperties": false
  }
}
