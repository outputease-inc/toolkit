# Claude Code ignore file
# Files/dirs listed here are excluded from Claude Code's context window
# https://docs.anthropic.com/en/docs/claude-code/configuration

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
.next/
dist/
build/
out/
.turbo/
.cache/

# Test outputs
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (defensive — keeps secrets out of context)
.env
.env.*
!.env.example

# Lockfiles (large, low signal)
bun.lock
package-lock.json
yarn.lock
pnpm-lock.yaml

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Generated artifacts
*.tsbuildinfo
*.d.ts.map
