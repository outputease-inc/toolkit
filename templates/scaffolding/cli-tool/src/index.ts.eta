#!/usr/bin/env bun
import { Command } from "commander";

const program = new Command()
  .name("<%= it.projectName %>")
  .description("A CLI tool built with Bun + Commander")
  .version("0.1.0");

program
  .command("hello")
  .description("Say hello")
  .argument("[name]", "Name to greet", "world")
  .action((name: string) => {
    console.log(`Hello, ${name}!`);
  });

program.parse();
