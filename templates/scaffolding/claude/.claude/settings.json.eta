{
  "permissions": {
    "allow": [
<% if (it.pm.name === "bun") { %>
      "Bash(bun install)",
      "Bash(bun test)",
      "Bash(bun run dev)",
      "Bash(bun run build)",
      "Bash(bun run lint)",
      "Bash(bun run format)",
      "Bash(bun run typecheck)",
      "Bash(bunx biome check *)"
<% } else if (it.pm.name === "npm") { %>
      "Bash(npm install)",
      "Bash(npm test)",
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm run typecheck)",
      "Bash(npx biome check *)"
<% } else if (it.pm.name === "yarn") { %>
      "Bash(yarn install)",
      "Bash(yarn test)",
      "Bash(yarn dev)",
      "Bash(yarn build)",
      "Bash(yarn lint)",
      "Bash(yarn format)",
      "Bash(yarn typecheck)",
      "Bash(yarn dlx biome check *)"
<% } else if (it.pm.name === "pnpm") { %>
      "Bash(pnpm install)",
      "Bash(pnpm test)",
      "Bash(pnpm run dev)",
      "Bash(pnpm run build)",
      "Bash(pnpm run lint)",
      "Bash(pnpm run format)",
      "Bash(pnpm run typecheck)",
      "Bash(pnpm dlx biome check *)"
<% } %>
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-sensitive.js\"",
            "timeout": 5,
            "statusMessage": "Checking file safety..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/prevent-barrel-bypass.js\"",
            "timeout": 5,
            "statusMessage": "Checking import paths..."
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-generated.js\"",
            "timeout": 5,
            "statusMessage": "Checking for generated-file edits..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-sensitive-bash.js\"",
            "timeout": 5,
            "statusMessage": "Checking command safety..."
          }
        ]
      }
    ]<% if (it.pm.name === "bun") { %>,
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-format.js\"",
            "timeout": 15,
            "statusMessage": "Auto-formatting with Biome..."
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/record-edits.js\"",
            "timeout": 5,
            "statusMessage": "Recording edit for batched verify..."
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/record-reads.js\"",
            "timeout": 5,
            "statusMessage": "Recording source hash for staleness check..."
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/record-reads.js\"",
            "timeout": 5,
            "statusMessage": "Recording source hash for staleness check..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/batch-typecheck.js\"",
            "timeout": 120,
            "statusMessage": "Running batched typecheck..."
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/batch-test.js\"",
            "timeout": 90,
            "statusMessage": "Running batched tests..."
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-sources.js\"",
            "timeout": 15,
            "statusMessage": "Checking read sources for mid-session drift..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/reset-edits.js\"",
            "timeout": 5,
            "statusMessage": "Resetting batched-verify state..."
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/reset-reads.js\"",
            "timeout": 5,
            "statusMessage": "Resetting source-staleness ledger..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/reset-edits.js\"",
            "timeout": 5,
            "statusMessage": "Resetting batched-verify state..."
          }
        ]
      }
    ]<% } %>
  }
}
