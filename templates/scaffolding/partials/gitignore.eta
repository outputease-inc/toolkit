# dependencies
node_modules/

# build output
dist/
build/
.next/
out/
<% if (it.frameworkConfig.framework === "astro") { %>.astro/
<% } %><% if (it.frameworkConfig.framework === "tauri") { %>src-tauri/target/
<% } %><% if (it.frameworkConfig.framework === "capacitor") { %>android/
ios/
<% } %>
# environment
.env
.env.local
.env.*.local

# toolkit first-run marker (per-clone; do NOT broaden to .outputease* -- the
# committed .outputease scaffold marker must stay tracked for `outputease update`)
/.outputease-first-run

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# debug
*.log
npm-debug.log*

# test coverage
coverage/

# Claude Code hook ledgers: the batched-verify sentinel (record-edits/reset-edits hooks)
# and the per-session source-staleness ledgers (record-reads/verify-sources/reset-reads hooks)
.claude/.last-edits.json
.claude/.last-reads/

# lock files (ignore every package manager's lockfile except the chosen one)
<%= Object.entries({ bun: "bun.lock", npm: "package-lock.json", yarn: "yarn.lock", pnpm: "pnpm-lock.yaml" }).filter(([pm]) => pm !== it.pm.name).map(([, file]) => file).join("\n") %>
